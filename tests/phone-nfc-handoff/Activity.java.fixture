package android.app; import android.content.*; import android.content.pm.PackageManager;
public class Activity extends Context {
 public final PackageManager pm=new PackageManager(); public final android.os.Messenger peer=new android.os.Messenger(new android.os.Handler(android.os.Looper.getMainLooper(),m->{lastRequest=m;return true;}));
 public android.os.Message lastRequest; public int checkSelfPermission(String p){return -1;} public PackageManager getPackageManager(){return pm;}
 public boolean bindService(Intent i,ServiceConnection c,int flags){c.onServiceConnected(new ComponentName(),peer.getBinder());return true;}
 public void unbindService(ServiceConnection c){} public void startActivityForResult(Intent i,int code){}
}
