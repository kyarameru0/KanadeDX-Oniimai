package io.oniimai.kanade;
import android.hardware.usb.*;
import java.io.IOException;
import java.util.*;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicReference;

public final class UsbTransportTest {
    private static int checks;
    private static void check(boolean ok,String message){if(!ok)throw new AssertionError(message);checks++;}
    private static UsbIo.Port port(){
        UsbInterface control=new UsbInterface(2,2),data=new UsbInterface(3,10,new UsbEndpoint(128,2),new UsbEndpoint(0,2));
        return new UsbIo.Port(new UsbDevice(control,data),control,"NFC");
    }
    private static UsbIo.Cdc open(UsbDeviceConnection c)throws IOException{return new UsbIo.Cdc(new UsbManager(c),port(),115200);}
    private static void failed(UsbDeviceConnection c)throws Exception{try{open(c);throw new AssertionError("expected open failure");}catch(IOException expected){checks++;}}
    private static UsbIo.Hid hid(UsbDeviceConnection conn,boolean withOut,UsbIo.Bytes bytes,UsbIo.Failure failure)throws Exception{
        UsbInterface intf=withOut?new UsbInterface(7,3,new UsbEndpoint(128,3),new UsbEndpoint(0,3)):new UsbInterface(7,3,new UsbEndpoint(128,3));
        UsbIo.Hid hid=new UsbIo.Hid(new UsbManager(conn),new UsbIo.Port(new UsbDevice(intf),intf,"IO4"),bytes,failure);
        check(conn.inputQueued.await(1,TimeUnit.SECONDS),"HID input reader did not queue");return hid;
    }
    private static void writeFails(UsbIo.Hid h){try{h.writeCeiling(0x123456);throw new AssertionError("output failure not reported");}catch(IOException expected){checks++;}}
    public static void main(String[] args)throws Exception{
        UsbDeviceConnection nfc=new UsbDeviceConnection();new UsbIo.Cdc(new UsbManager(nfc),port(),115200,1).close();
        check(nfc.lineStates.equals(Arrays.asList(1,0)),"NFC Windows-compatible DTR-only open and clear on close");
        UsbDeviceConnection defaultLines=new UsbDeviceConnection();open(defaultLines).close();
        check(defaultLines.lineStates.equals(Arrays.asList(3,0)),"Other CDC ports retain DTR+RTS default");
        UsbDeviceConnection badLines=new UsbDeviceConnection();
        try{new UsbIo.Cdc(new UsbManager(badLines),port(),115200,4);throw new AssertionError("invalid line state accepted");}catch(IllegalArgumentException expected){check(badLines.claims.isEmpty(),"Invalid CDC options fail before touching USB");}
        UsbDeviceConnection noControl=new UsbDeviceConnection();noControl.failClaim=2;failed(noControl);
        check(noControl.releases.isEmpty(),"failed claimant released an unowned interface");
        check(noControl.dtrOff.get()==0&&noControl.coding.get()==0,"failed claimant changed another channel's line state");
        check(noControl.closes.get()==1,"failed claim leaked handle");
        UsbDeviceConnection noData=new UsbDeviceConnection();noData.failClaim=3;failed(noData);
        check(noData.releases.equals(Arrays.asList(2)),"partial claim must release only control");
        check(noData.dtrOff.get()==0&&noData.dtrOn.get()==0,"partial claim changed DTR");
        UsbDeviceConnection badCoding=new UsbDeviceConnection();badCoding.failCoding=true;failed(badCoding);
        check(badCoding.releases.equals(Arrays.asList(3,2)),"configuration failure leaked claims");
        check(badCoding.dtrOff.get()==0,"untouched DTR was changed on coding failure");
        UsbDeviceConnection normal=new UsbDeviceConnection();UsbIo.Cdc cdc=open(normal);
        Thread a=new Thread(cdc::close),b=new Thread(cdc::close);a.start();b.start();a.join(2000);b.join(2000);cdc.close();
        check(normal.dtrOn.get()==1&&normal.dtrOff.get()==1,"line state cleanup repeated");
        check(normal.releases.equals(Arrays.asList(3,2))&&normal.closes.get()==1,"close must release each owned resource once");
        try{cdc.write(new byte[]{1});throw new AssertionError("closed write accepted");}catch(IOException expected){checks++;}
        check(normal.writes.get()==0,"closed port issued USB write");
        UsbDeviceConnection releaseError=new UsbDeviceConnection();releaseError.throwRelease=3;open(releaseError).close();
        check(releaseError.releases.equals(Arrays.asList(3,2))&&releaseError.closes.get()==1,"data release failure skipped control cleanup");
        UsbDeviceConnection blocked=new UsbDeviceConnection();UsbIo.Cdc writing=open(blocked);
        blocked.writing=new CountDownLatch(1);blocked.proceed=new CountDownLatch(1);AtomicReference<Throwable> writeFailure=new AtomicReference<>();
        Thread writer=new Thread(()->{try{writing.write(new byte[96]);}catch(Throwable t){writeFailure.set(t);}});writer.start();
        check(blocked.writing.await(1,TimeUnit.SECONDS),"write did not start");
        Thread closer=new Thread(writing::close);closer.start();
        long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(1);
        while(closer.getState()!=Thread.State.BLOCKED&&System.nanoTime()<deadline)Thread.yield();
        check(closer.getState()==Thread.State.BLOCKED,"close did not serialize behind active write");
        check(blocked.closes.get()==0,"fd closed during active write");blocked.proceed.countDown();
        writer.join(2000);closer.join(2000);
        check(!writer.isAlive()&&!closer.isAlive(),"close/write deadlock");
        check(blocked.writes.get()==1&&writeFailure.get() instanceof IOException,"canceled write sent remaining chunks");
        check(blocked.closes.get()==1&&blocked.dtrOff.get()==1,"write cancellation did not clean up");
        UsbInterface missing=new UsbInterface(9,3);UsbIo.Port removed=new UsbIo.Port(new UsbDevice(),missing,"HID");
        UsbDeviceConnection hidFailure=new UsbDeviceConnection();
        try{new UsbIo.Hid(new UsbManager(hidFailure),removed,(data,n)->{},message->{});throw new AssertionError("missing HID accepted");}catch(IOException expected){checks++;}
        check(hidFailure.closes.get()==1,"HID interface lookup failure leaked fd");
        ceilingTests();
        System.out.println("PASS: "+checks+" USB transport ownership/cancellation checks");
    }
    private static void ceilingTests()throws Exception{
        UsbDeviceConnection out=new UsbDeviceConnection();List<String> errors=Collections.synchronizedList(new ArrayList<>());
        CountDownLatch input=new CountDownLatch(1);AtomicReference<byte[]> inputBytes=new AtomicReference<>();
        UsbIo.Hid h=hid(out,true,(bytes,n)->{inputBytes.set(bytes);input.countDown();},errors::add);
        h.writeCeiling(0x12d0e0);
        check(out.outputWrites.get()==1&&out.setReports.get()==0,"interrupt OUT must be preferred to control");
        check(Arrays.equals(out.lastReport,Io4Output.ceiling(0x12d0e0)),"interrupt report packing");
        check(out.claims.equals(Arrays.asList(7)),"ceiling output claimed another USB handle/interface");
        out.deliverInput(new byte[]{1,2,3});check(input.await(1,TimeUnit.SECONDS),"input lost after output completion");
        check(Arrays.equals(inputBytes.get(),new byte[]{1,2,3})&&errors.isEmpty(),"output completion was dispatched as button input");
        h.writeCeiling(0);check(out.outputWrites.get()==2,"second output failed");h.close();h.close();
        writeFails(h);check(out.closes.get()==1&&out.outputWrites.get()==2,"closed HID sent report or double closed fd");

        UsbDeviceConnection control=new UsbDeviceConnection();UsbIo.Hid c=hid(control,false,(bytes,n)->{},errors::add);
        c.writeCeiling(0x123456);
        check(control.setReports.get()==1&&control.outputWrites.get()==0,"missing OUT did not use SET_REPORT");
        check(control.reportType==0x21&&control.reportRequest==9&&control.reportValue==0x210&&control.reportIndex==7,"SET_REPORT setup incorrect");
        check(control.reportTimeout>0&&control.reportTimeout<=500&&Arrays.equals(control.lastReport,Io4Output.ceiling(0x123456)),"SET_REPORT bound or payload incorrect");c.close();

        UsbDeviceConnection shortReport=new UsbDeviceConnection();shortReport.shortOutput=true;
        UsbIo.Hid sh=hid(shortReport,true,(bytes,n)->{},errors::add);writeFails(sh);writeFails(sh);
        check(shortReport.outputWrites.get()==1&&shortReport.closes.get()==0,"short report should disable only output");sh.close();

        UsbDeviceConnection stall=new UsbDeviceConnection();stall.blockOutput=true;
        CountDownLatch stillInput=new CountDownLatch(1);UsbIo.Hid st=hid(stall,true,(bytes,n)->stillInput.countDown(),errors::add);
        long before=System.nanoTime();writeFails(st);
        check(System.nanoTime()-before<TimeUnit.SECONDS.toNanos(2),"output timeout is not bounded");
        stall.deliverInput(new byte[]{1});check(stillInput.await(1,TimeUnit.SECONDS),"output timeout canceled button input");
        writeFails(st);check(stall.outputWrites.get()==1&&stall.closes.get()==0&&errors.isEmpty(),"timed-out output reused request or closed input");st.close();

        UsbDeviceConnection closing=new UsbDeviceConnection();closing.blockOutput=true;
        UsbIo.Hid ch=hid(closing,true,(bytes,n)->{},errors::add);AtomicReference<Throwable> failure=new AtomicReference<>();
        Thread writer=new Thread(()->{try{ch.writeCeiling(0xff0000);}catch(Throwable e){failure.set(e);}});writer.start();
        check(closing.outputQueued.await(1,TimeUnit.SECONDS),"close test output did not queue");
        Thread close=new Thread(ch::close);close.start();writer.join(1500);close.join(1500);
        check(!writer.isAlive()&&!close.isAlive()&&failure.get() instanceof IOException,"HID close did not cancel pending output");
        check(closing.closes.get()==1&&closing.outputWrites.get()==1,"pending output cleanup count");

        UsbDeviceConnection controlClosing=new UsbDeviceConnection();controlClosing.writing=new CountDownLatch(1);controlClosing.proceed=new CountDownLatch(1);
        UsbIo.Hid cc=hid(controlClosing,false,(bytes,n)->{},errors::add);AtomicReference<Throwable> controlFailure=new AtomicReference<>();
        Thread controlWriter=new Thread(()->{try{cc.writeCeiling(0xabc123);}catch(Throwable e){controlFailure.set(e);}});controlWriter.start();
        check(controlClosing.writing.await(1,TimeUnit.SECONDS),"control write did not start");
        Thread controlCloser=new Thread(cc::close);controlCloser.start();
        long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(1);
        while(controlCloser.getState()!=Thread.State.BLOCKED&&System.nanoTime()<deadline)Thread.yield();
        check(controlCloser.getState()==Thread.State.BLOCKED&&controlClosing.closes.get()==0,"closed fd during SET_REPORT");
        controlClosing.proceed.countDown();controlWriter.join(1500);controlCloser.join(1500);
        check(!controlWriter.isAlive()&&!controlCloser.isAlive()&&controlClosing.closes.get()==1,"control close deadlock or leak");
        check(controlFailure.get()==null||controlFailure.get() instanceof IOException,"unexpected control close failure");
        check(errors.isEmpty(),"ceiling errors leaked into input failure callback");
    }
}
